local frameCount, lastUpdate = 0, tick()
RunService.RenderStepped:Connect(function()
    frameCount = frameCount + 1
    local now = tick()
    if now - lastUpdate >= 1 then
        local ping = 0
        pcall(function() ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue()) end)
        StatsText.Text = string.format("FPS: %d  |  PING: %dms", frameCount, ping)
        frameCount = 0
        lastUpdate = now
    end
end)

--Sistema inteligente de búsqueda de jugadores
local DIVE_SPEED = 1000 
local HUNT_SPEED = 60 
local UNDERGROUND_Y = 20 -- Fica profundamente abaixo do mapa, imune a variações de montanhas

local autoArrestActive = false
local engineRunning = false
local priorityTarget = nil
local noclipConnection = nil
local arrestedCooldown = {}

--Armas que convierten a un recluso en un blanco
local DANGER_ITEMS = {"M9", "Remington 870", "AK-47", "Hammer", "Crude Knife", "Riot Shield", "Knife"}

local function ToggleNoclip(state)
    if state then
        if not noclipConnection then
            noclipConnection = RunService.Stepped:Connect(function()
                if LocalPlayer.Character then
                    for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
                        if part:IsA("BasePart") then part.CanCollide = false end
                    end
                end
            end)
        end
    else
        if noclipConnection then noclipConnection:Disconnect(); noclipConnection = nil end
    end
end

local function getRemotes()
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    return remotes and remotes:FindFirstChild("ArrestPlayer"), remotes and remotes:FindFirstChild("InteractWithItem")
end

local function equipCuffs()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChild("Humanoid")
    if not hum then return end
    
    local cuffs = LocalPlayer.Backpack:FindFirstChild("Handcuffs") or char:FindFirstChild("Handcuffs")
    if cuffs then 
        hum:EquipTool(cuffs) 
    end
end

--Sistema de detección: Criminales armados o reclusos
local function isThreat(plr)
    if not plr or not plr.Character then return false end
    local hum = plr.Character:FindFirstChild("Humanoid")
    if not hum or hum.Health <= 0 then return false end 
    
    --Si se trata de un jugador con antecedentes penales, se convierte en objetivo de inmediato. 
    if plr.Team and string.lower(plr.Team.Name) == "criminals" then 
        return true 
    end
    
    --Si es un prisionero, compruebe si lleva un arma
    if plr.Team and string.lower(plr.Team.Name) == "prisoners" then
        local function hasWeapon(parent)
            if not parent then return false end
            for _, item in pairs(parent:GetChildren()) do
                if item:IsA("Tool") and table.find(DANGER_ITEMS, item.Name) then
                    return true
                end
            end
            return false
        end
        
        --Verificador de armas (almacenado o equipado)
        if hasWeapon(plr.Character) or hasWeapon(plr:FindFirstChild("Backpack")) then
            return true
        end
    end
    
    return false
end

local function getClosestTarget(pos)
    local bestTarget = nil
    local minDist = math.huge
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and isThreat(p) and not arrestedCooldown[p.UserId] then
            local pHrp = p.Character:FindFirstChild("HumanoidRootPart")
            if pHrp then
                local dist = (pHrp.Position - pos).Magnitude
                if dist < minDist then
                    minDist = dist
                    bestTarget = p
                end
            end
        end
    end
    return bestTarget
end

local function startEngine()
    if engineRunning then return end
    engineRunning = true
    
    task.spawn(function()
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then engineRunning = false return end

        local originalPos = hrp.Position
        ToggleNoclip(true)
        hrp.Anchored = false 

        local proxy = Instance.new("Part")
        proxy.Anchored = true
        proxy.Transparency = 1
        proxy.CanCollide = false
        proxy.CFrame = hrp.CFrame
        proxy.Parent = Workspace

        --¡Sistema de placas artificiales!
        local safePlate = Instance.new("Part")
        safePlate.Size = Vector3.new(3, 0.05, 3) 
        safePlate.Transparency = 0.2
        safePlate.Color = Color3.fromRGB(0, 255, 200) -- Ciano/Verde Neon
        safePlate.Material = Enum.Material.Neon
        safePlate.CanCollide = false -- Impede conflito de física (impede o teleporte bugado)
        safePlate.Anchored = true
        safePlate.Parent = Workspace 

        local updateConnection = RunService.Heartbeat:Connect(function()
            if hrp and proxy then
                hrp.CFrame = proxy.CFrame
                hrp.AssemblyLinearVelocity = Vector3.new(0,0,0)
                
                --Actualización de la posición de la placa artificial
                if safePlate and safePlate.Parent then
                    safePlate.CFrame = proxy.CFrame * CFrame.new(0, -3.1, 0)
                end
            end
        end)

        --Baja la placa artificial a una altura segura (Y = 20)
        local subPos = Vector3.new(originalPos.X, UNDERGROUND_Y, originalPos.Z)
        while engineRunning and (proxy.Position - subPos).Magnitude > 2 do
            local dir = (subPos - proxy.Position).Unit
            proxy.CFrame = proxy.CFrame + (dir * DIVE_SPEED * RunService.Heartbeat:Wait())
        end

        --Bucle del jugador de prisión
        while autoArrestActive or priorityTarget do
            local currentTarget = priorityTarget
            
            if not currentTarget or not isThreat(currentTarget) then
                priorityTarget = nil
                currentTarget = getClosestTarget(proxy.Position)
            end

            if currentTarget then
                local tChar = currentTarget.Character
                local tHrp = tChar and tChar:FindFirstChild("HumanoidRootPart")
                
                if tHrp then
                    --Cazar bajo tierra de forma horizontal
                    while (autoArrestActive or priorityTarget) and isThreat(currentTarget) do
                        local dest = Vector3.new(tHrp.Position.X, UNDERGROUND_Y, tHrp.Position.Z)
                        local dist = (proxy.Position - dest).Magnitude
                        if dist < 4 then break end 
                        
                        --El cambio de objetivo se produce si uno se acerca demasiado
                        if not priorityTarget then
                            local closer = getClosestTarget(proxy.Position)
                            if closer and closer ~= currentTarget then
                                local cHrp = closer.Character:FindFirstChild("HumanoidRootPart")
                                if cHrp then
                                    local cDist = (Vector3.new(cHrp.Position.X, UNDERGROUND_Y, cHrp.Position.Z) - proxy.Position).Magnitude
                                    if cDist < dist - 20 then 
                                        currentTarget = closer
                                        tChar = currentTarget.Character
                                        tHrp = cHrp
                                    end
                                end
                            end
                        end

                        local dir = (dest - proxy.Position).Unit
                        proxy.CFrame = proxy.CFrame + (dir * HUNT_SPEED * RunService.Heartbeat:Wait())
                    end

                    --Momento de la detención del jugador
                    if isThreat(currentTarget) then
                        local arrestR, interactR = getRemotes()
                        
                        --Jugador Esposado rápidamente 
                        for i = 1, 12 do
                            if not isThreat(currentTarget) then break end
                            
                            --Estar 6,5 bloques por debajo del objetivo
                            proxy.CFrame = tHrp.CFrame * CFrame.new(0, -6.5, 0)
                            
                            equipCuffs() -- Força equipar rápido toda vez
                            
                            if arrestR then pcall(function() arrestR:InvokeServer(currentTarget, 1) end) end
                            if interactR then pcall(function() interactR:InvokeServer(currentTarget) end) end
                            
                            task.wait(0.05) -- Muito mais rápido que antes
                        end
                        
                        arrestedCooldown[currentTarget.UserId] = true
                        task.delay(10, function() arrestedCooldown[currentTarget.UserId] = nil end)
                        if priorityTarget == currentTarget then priorityTarget = nil end
                        
                        --Ir a Altura 20 Subterránea Sapidamente
                        if tHrp then
                            local hidePos = Vector3.new(tHrp.Position.X, UNDERGROUND_Y, tHrp.Position.Z)
                            while (proxy.Position - hidePos).Magnitude > 2 do
                                local dir = (hidePos - proxy.Position).Unit
                                proxy.CFrame = proxy.CFrame + (dir * DIVE_SPEED * RunService.Heartbeat:Wait())
                            end
                        end
                    end
                end
            else
                task.wait(0.1) 
            end
        end

        --Una vez finalizado el script, este devuelve al usuario a su posición anterior
        local returnSubPos = Vector3.new(originalPos.X, UNDERGROUND_Y, originalPos.Z)
        while (proxy.Position - returnSubPos).Magnitude > 2 do
            local dir = (returnSubPos - proxy.Position).Unit
            proxy.CFrame = proxy.CFrame + (dir * HUNT_SPEED * RunService.Heartbeat:Wait())
        end
        while (proxy.Position - originalPos).Magnitude > 2 do
            local dir = (originalPos - proxy.Position).Unit
            proxy.CFrame = proxy.CFrame + (dir * DIVE_SPEED * RunService.Heartbeat:Wait())
        end
        proxy.CFrame = CFrame.new(originalPos)

        --Equipo de limpieza utilizado según el guion
        updateConnection:Disconnect()
        proxy:Destroy()
        safePlate:Destroy()
        hrp.Anchored = false
        ToggleNoclip(false)
        engineRunning = false
    end)
end

