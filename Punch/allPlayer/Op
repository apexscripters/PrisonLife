    pcall(function()
        local remotesFolder = ReplicatedStorage:FindFirstChild("Remotes")
        local crouchRemote = ReplicatedStorage:FindFirstChild("Crouch") or (remotesFolder and remotesFolder:FindFirstChild("Crouch"))
        if crouchRemote then crouchRemote:FireServer(state) end
