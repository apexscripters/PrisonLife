LocalPlayer.CharacterAdded:Connect(function(newChar)
    engineRunning = false 
    resetHeightCache()
    setupAntiSeat()
    if autoPunchActive then
        task.spawn(function()
            newChar:WaitForChild("HumanoidRootPart", 5)
            task.wait(0.4)
            if autoPunchActive and not engineRunning then
                startEngine()
            end
        end)
    end
end)

