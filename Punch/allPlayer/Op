local function isInCar(plr)
    if not plr or not plr.Character then return false end
    local hum = plr.Character:FindFirstChild("Humanoid")
    if hum and (hum.Sit or (hum.SeatPart and hum.SeatPart:IsA("VehicleSeat"))) then
        return true
    end
    return false
end

local function isJumping(hum)
    if not hum then return false end
    local state = hum:GetState()
    return state == Enum.HumanoidStateType.Jumping or state == Enum.HumanoidStateType.Freefall or hum.FloorMaterial == Enum.Material.Air
end

local function isValidTarget(plr)
    if not plr or not plr.Character then return false end
    local hum = plr.Character:FindFirstChild("Humanoid")
    if not hum or hum.Health <= 0 then return false end 
    if plr.Character:FindFirstChildOfClass("ForceField") then return false end
    if isInCar(plr) then return false end 
    return true
end

local function getClosestTarget(pos)
    local bestTarget = nil
    local minDist = math.huge
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and isValidTarget(p) then
            local pHrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
            if pHrp then
                local dist = (pHrp.Position - pos).Magnitude
                if dist < minDist then
                    minDist = dist
                    bestTarget = p
                end
            end
        end
    end
    return bestTarget
end

local function doPunch(target)
    pcall(function()
        local char = LocalPlayer.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return end

        local tool = char:FindFirstChild("Punch") or char:FindFirstChild("Melee") or char:FindFirstChild("Combat") or char:FindFirstChild("Fists")
        if not tool and LocalPlayer:FindFirstChild("Backpack") then
            tool = LocalPlayer.Backpack:FindFirstChild("Punch") or LocalPlayer.Backpack:FindFirstChild("Melee") or LocalPlayer.Backpack:FindFirstChild("Combat") or LocalPlayer.Backpack:FindFirstChild("Fists")
        end

        if tool then
            if tool.Parent ~= char then hum:EquipTool(tool) end
            tool:Activate() 
        end

        local remotesFolder = ReplicatedStorage:FindFirstChild("Remotes")
        local possibleEvents = {
            ReplicatedStorage:FindFirstChild("meleeEvent"),
            ReplicatedStorage:FindFirstChild("CombatEvent"),
            ReplicatedStorage:FindFirstChild("PunchEvent"),
            ReplicatedStorage:FindFirstChild("AttackEvent"),
            ReplicatedStorage:FindFirstChild("HitEvent"),
            remotesFolder and remotesFolder:FindFirstChild("meleeEvent"),
            remotesFolder and remotesFolder:FindFirstChild("CombatEvent"),
            remotesFolder and remotesFolder:FindFirstChild("PunchEvent")
        }

        for _, ev in pairs(possibleEvents) do
            if ev and ev:IsA("RemoteEvent") then
                pcall(function()
                    ev:FireServer(target, 1, 1)
                    ev:FireServer(target.Character, 1, 1)
                end)
            end
        end
    end)
end

-- ============================================================================
-- SISTEMA DE MOVIMENTAÇÃO E TWEEN REVISADO (ÚNICA AUTORIDADE)
-- ============================================================================
local function tweenTo(proxy, destPos, followTerrain)
    if currentTween then currentTween:Cancel(); currentTween = nil end
    if tweenHeartbeatConn then tweenHeartbeatConn:Disconnect(); tweenHeartbeatConn = nil end
    if currentDummyVal then currentDummyVal:Destroy(); currentDummyVal = nil end

    if not proxy or not proxy.Parent then return end

    local targetPos = (typeof(destPos) == "CFrame") and destPos.Position or destPos
    local startPos = proxy.Position

    -- Calcula distância somente no plano X/Z
    local horizontalDist = (Vector3.new(startPos.X, 0, startPos.Z) - Vector3.new(targetPos.X, 0, targetPos.Z)).Magnitude

    if horizontalDist < 0.5 then
        local finalY = followTerrain and getDesiredY(targetPos) or targetPos.Y
        proxy.CFrame = CFrame.new(targetPos.X, finalY, targetPos.Z)
        return
    end

    local timeVal = math.max(horizontalDist / FLIGHT_SPEED, 0.05)
    local tweenInfo = TweenInfo.new(timeVal, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut)

    if followTerrain then
        -- O DUMMY agora é um Vector3Value. Ele interpola APENAS os eixos X e Z.
        currentDummyVal = Instance.new("Vector3Value")
        currentDummyVal.Value = Vector3.new(startPos.X, 0, startPos.Z)

        local endDummy = Vector3.new(targetPos.X, 0, targetPos.Z)
        currentTween = TweenService:Create(currentDummyVal, tweenInfo, {Value = endDummy})
        
        -- O Heartbeat é a ÚNICA AUTORIDADE a definir a CFrame do proxyPart
        tweenHeartbeatConn = RunService.Heartbeat:Connect(function()
            if not currentDummyVal or not proxy or not proxy.Parent then return end
            
            local currentXZ = currentDummyVal.Value
            
            -- Passamos a posição X/Z interpolada pelo Tween e o Y atual do proxy para o Raycast saber de onde calcular
            local checkPos = Vector3.new(currentXZ.X, proxy.Position.Y, currentXZ.Z)
            local desiredY = getDesiredY(checkPos)
            
            -- Mesclagem final: X/Z do Tween, Y do terreno
            proxy.CFrame = CFrame.new(currentXZ.X, desiredY, currentXZ.Z)
        end)
        
        currentTween:Play()
    else
        -- Voo direto sem seguir terreno (ex: ao desligar para voltar à base)
        currentTween = TweenService:Create(proxy, tweenInfo, {CFrame = CFrame.new(targetPos)})
        currentTween:Play()
    end

    local startTime = tick()
    while currentTween and currentTween.PlaybackState == Enum.PlaybackState.Playing and (tick() - startTime) < (timeVal + 0.1) do
        RunService.Heartbeat:Wait()
    end

    if tweenHeartbeatConn then tweenHeartbeatConn:Disconnect(); tweenHeartbeatConn = nil end
    if currentDummyVal then currentDummyVal:Destroy(); currentDummyVal = nil end
end

-- Engine Principal
local function startEngine()
    if engineRunning then return end
    engineRunning = true

    resetHeightCache()

    task.spawn(function()
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then 
            engineRunning = false 
            return 
        end

        local originalPos = hrp.Position
        ToggleNoclip(true)
        setupAntiSeat()
        setRemoteCrouch(true)
        hrp.Anchored = false 

        proxyPart = Instance.new("Part")
        proxyPart.Anchored = true
        proxyPart.Transparency = 1
        proxyPart.CanCollide = false
        proxyPart.CFrame = hrp.CFrame
        proxyPart.Parent = Workspace

        safePlatePart = Instance.new("Part")
        safePlatePart.Size = Vector3.new(12, 0.2, 12) 
        safePlatePart.Transparency = 0.3
        safePlatePart.Color = Color3.fromRGB(255, 50, 50)
        safePlatePart.Material = Enum.Material.Neon
        safePlatePart.CanCollide = true 
        safePlatePart.Anchored = true
        safePlatePart.Parent = Workspace 

        updateConnection = RunService.Heartbeat:Connect(function()
            if hrp and proxyPart and hrp.Parent then
                hrp.CFrame = proxyPart.CFrame
                hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                if safePlatePart and safePlatePart.Parent then
                    -- Usa Vector3 para evitar rotacionar a plataforma baseando-se no LookVector do char
                    safePlatePart.Position = proxyPart.Position - Vector3.new(0, 3.1, 0)
                    safePlatePart.Rotation = Vector3.new(0, 0, 0)
                end
            end
        end)

        local initialY = getDesiredY(originalPos)
        local subPos = Vector3.new(originalPos.X, initialY, originalPos.Z)
        tweenTo(proxyPart, subPos, true)

        while autoPunchActive do
            local currentChar = LocalPlayer.Character
            local currentHum = currentChar and currentChar:FindFirstChildOfClass("Humanoid")
            if not currentChar or currentChar ~= char or not currentHum or currentHum.Health <= 0 then
                break
            end

            local currentTarget = priorityTarget

            if not currentTarget or not isValidTarget(currentTarget) then
                priorityTarget = nil
                currentTarget = getClosestTarget(proxyPart.Position)
            end

            if currentTarget then
                local tChar = currentTarget.Character
                local tHrp = tChar and tChar:FindFirstChild("HumanoidRootPart")
                local tHum = tChar and tChar:FindFirstChild("Humanoid")

                if tHrp and tHum then
                    while autoPunchActive and isValidTarget(currentTarget) and (priorityTarget == nil or priorityTarget == currentTarget) do
                        local cCharCheck = LocalPlayer.Character
                        local cHumCheck = cCharCheck and cCharCheck:FindFirstChildOfClass("Humanoid")
                        if not cCharCheck or cCharCheck ~= char or not cHumCheck or cHumCheck.Health <= 0 then break end
                        if isInCar(currentTarget) then break end 

                        local tHrpCheck = currentTarget.Character and currentTarget.Character:FindFirstChild("HumanoidRootPart")
                        if not tHrpCheck then break end

                        local dist = (Vector3.new(proxyPart.Position.X, 0, proxyPart.Position.Z) - Vector3.new(tHrpCheck.Position.X, 0, tHrpCheck.Position.Z)).Magnitude
                        if dist < 8 then break end 

                        tweenTo(proxyPart, tHrpCheck.Position, true)
                    end

                    if autoPunchActive and isValidTarget(currentTarget) and not isInCar(currentTarget) then
                        while autoPunchActive and isValidTarget(currentTarget) and not isInCar(currentTarget) do
                            local cCharCheck = LocalPlayer.Character
                            local cHumCheck = cCharCheck and cCharCheck:FindFirstChildOfClass("Humanoid")
                            if not cCharCheck or cCharCheck ~= char or not cHumCheck or cHumCheck.Health <= 0 then break end

                            local tHrpCheck = currentTarget.Character and currentTarget.Character:FindFirstChild("HumanoidRootPart")
                            local tHumCheck = currentTarget.Character and currentTarget.Character:FindFirstChild("Humanoid")
                            if not tHrpCheck or not tHrpCheck.Parent or not tHumCheck or tHumCheck.Health <= 0 then break end

                            if not isJumping(tHumCheck) then
                                local targetPos = tHrpCheck.Position
                                local desiredY = getDesiredY(targetPos)
                                proxyPart.CFrame = CFrame.new(targetPos.X, desiredY, targetPos.Z)
                            end

                            doPunch(currentTarget)
                            task.wait(0.05)
                        end

                        if priorityTarget == currentTarget then priorityTarget = nil end
                    end
                end
            else
                local homeY = getDesiredY(originalPos)
                local homeSub = Vector3.new(originalPos.X, homeY, originalPos.Z)
                local distHome = (Vector3.new(proxyPart.Position.X, 0, proxyPart.Position.Z) - Vector3.new(originalPos.X, 0, originalPos.Z)).Magnitude

                if distHome > 2 then
                    tweenTo(proxyPart, homeSub, true)
                else
                    task.wait(0.1)
                end
            end

            task.wait(0.05)
        end

        if currentTween then currentTween:Cancel() end
        setRemoteCrouch(false)

        pcall(function()
            if hrp and hrp.Parent then
                local returnY = getDesiredY(originalPos)
                local returnSubPos = Vector3.new(originalPos.X, returnY, originalPos.Z)
                tweenTo(proxyPart, returnSubPos, true)
                tweenTo(proxyPart, originalPos, false)
            end
        end)

        if updateConnection then updateConnection:Disconnect(); updateConnection = nil end
        if tweenHeartbeatConn then tweenHeartbeatConn:Disconnect(); tweenHeartbeatConn = nil end
        if currentTween then currentTween:Cancel() end
        if currentDummyVal then currentDummyVal:Destroy() end
        if antiSeatConnection then antiSeatConnection:Disconnect() end

        pcall(function() proxyPart:Destroy() end)
        pcall(function() safePlatePart:Destroy() end)
        if hrp and hrp.Parent then hrp.Anchored = false end
        ToggleNoclip(false)
        engineRunning = false
        resetHeightCache()
    end)
end

-- Função de Limpeza Total
fullCleanup = function()
    autoPunchActive = false
    engineRunning = false
    resetHeightCache()

    if currentTween then currentTween:Cancel() end
    if tweenHeartbeatConn then tweenHeartbeatConn:Disconnect() end
    if updateConnection then updateConnection:Disconnect() end
    if noclipConnection then noclipConnection:Disconnect() end
    if antiSeatConnection then antiSeatConnection:Disconnect() end
    setRemoteCrouch(false)

    pcall(function() if currentDummyVal then currentDummyVal:Destroy() end end)
    pcall(function()
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            LocalPlayer.Character.HumanoidRootPart.Anchored = false
        end
    end)

    pcall(function() if proxyPart then proxyPart:Destroy() end end)
    pcall(function() if safePlatePart then safePlatePart:Destroy() end end)
    pcall(function() ScreenGui:Destroy() end)
end

