-- Sistema de operações
local FLIGHT_SPEED = 50

-- ============================================================================
-- CONFIGURAÇÕES DE ALTURA DINÂMICA E TERRENO
-- ============================================================================
local HEIGHT_OFFSET = -3
local RAYCAST_DISTANCE = 500
local HEIGHT_UPDATE_INTERVAL = 0.005
local HEIGHT_DEADZONE = 0.05
local XZ_CACHE_THRESHOLD = 1.0 

-- Variáveis de controle de cache
local lastValidY = nil
local lastXZPosition = nil
local lastHeightUpdate = 0
local cachedDesiredY = nil

-- Instância reutilizável de RaycastParams
local heightRaycastParams = RaycastParams.new()
heightRaycastParams.FilterType = Enum.RaycastFilterType.Exclude
heightRaycastParams.IgnoreWater = true

-- Instâncias globais de controle
local proxyPart = nil
local safePlatePart = nil

-- Limpa completamente o cache e forçará um novo cálculo
local function resetHeightCache()
    lastValidY = nil
    lastXZPosition = nil
    lastHeightUpdate = 0
    cachedDesiredY = nil
    
    -- Reconstrói os parâmetros para evitar referências mortas após respawn
    heightRaycastParams = RaycastParams.new()
    heightRaycastParams.FilterType = Enum.RaycastFilterType.Exclude
    heightRaycastParams.IgnoreWater = true
end

-- ============================================================================
-- VALIDAÇÃO DA SUPERFÍCIE (Filtro configurável)
-- ============================================================================
local function isValidSurface(instance)
    if not instance then return false end
    
    -- 1. Ignorar partes invisíveis (frequentemente hitboxes ou barreiras)
    if instance.Transparency >= 1 then return false end
    
    -- 2. Ignorar partes que não tem colisão
    if not instance.CanCollide then return false end
    
    -- 3. Ignorar personagens de outros jogadores ou NPCs
    local model = instance:FindFirstAncestorOfClass("Model")
    if model then
        local humanoid = model:FindFirstChildOfClass("Humanoid")
        if humanoid then return false end
    end
    
    -- Adicione outras regras aqui para o seu projeto específico
    return true
end

-- Atualiza a lista de objetos ignorados pelo Raycast do terreno
local function updateRaycastFilter()
    local ignoreList = {}
    if LocalPlayer.Character then table.insert(ignoreList, LocalPlayer.Character) end
    if proxyPart then table.insert(ignoreList, proxyPart) end
    if safePlatePart then table.insert(ignoreList, safePlatePart) end
    
    -- Ignorar outros jogadores para não "pular" em cima deles
    for _, plr in pairs(Players:GetPlayers()) do
        if plr.Character then table.insert(ignoreList, plr.Character) end
    end
    
    heightRaycastParams.FilterDescendantsInstances = ignoreList
end

-- Retorna a posição (Vector3) do solo, ignorando obstáculos falsos e tetos
local function getGroundPosition(position)
    if not position then return nil end
    updateRaycastFilter()

    -- Mantemos a origem alta (+100) para evitar que o raio inicie dentro de ladeiras ou montanhas.
    local rayOrigin = Vector3.new(position.X, position.Y + 100, position.Z)
    local rayDirection = Vector3.new(0, -RAYCAST_DISTANCE, 0)
    
    local currentIgnoreList = {table.unpack(heightRaycastParams.FilterDescendantsInstances)}
    
    local validHits = {}
    local maxPierces = 30 -- Limite aumentado para conseguir atravessar arranha-céus e múltiplos tetos

    -- Atira o raio múltiplas vezes, ignorando o que acabou de bater para "perfurar" a estrutura
    for i = 1, maxPierces do
        heightRaycastParams.FilterDescendantsInstances = currentIgnoreList
        local raycastResult = Workspace:Raycast(rayOrigin, rayDirection, heightRaycastParams)
        
        if raycastResult then
            if isValidSurface(raycastResult.Instance) then
                table.insert(validHits, raycastResult.Position)
            end
            
            -- Adiciona o obstáculo atingido na ignore list para que o próximo raycast passe através dele
            table.insert(currentIgnoreList, raycastResult.Instance)
            
            -- Otimização: se o raio já desceu consideravelmente abaixo do personagem, podemos parar de perfurar
            if raycastResult.Position.Y < position.Y - 50 then
                break
            end
        else
            -- Nada encontrado até o limite do raio
            break
        end
    end

    if #validHits == 0 then return nil end

    -- CORREÇÃO PRINCIPAL: Diferenciação de Solo vs Teto
    -- Dentre todos os objetos atravessados na vertical, o chão verdadeiro é sempre o que está
    -- com a altura (Y) mais próxima da altura de referência que o sistema pediu (position.Y).
    local bestHit = nil
    local minDiff = math.huge

    for _, hitPos in ipairs(validHits) do
        local diff = math.abs(hitPos.Y - position.Y)
        
        if diff < minDiff then
            minDiff = diff
            bestHit = hitPos
        end
    end

    return bestHit
end

local function getSurfaceY(position)
    local groundPos = getGroundPosition(position)
    return groundPos and groundPos.Y or nil
end

local function getDesiredY(position)
    if not position then return cachedDesiredY or 0 end
    local now = tick()
    local currentXZ = Vector3.new(position.X, 0, position.Z)

    -- Invalida o cache se o deslocamento horizontal for maior que o limite
    local movedSignificantly = not lastXZPosition or (currentXZ - lastXZPosition).Magnitude > XZ_CACHE_THRESHOLD

    -- Usa o cache se não moveu muito e está dentro do tempo limite
    if not movedSignificantly and cachedDesiredY and (now - lastHeightUpdate) < HEIGHT_UPDATE_INTERVAL then
        return cachedDesiredY
    end

    local surfaceY = getSurfaceY(position)

    if surfaceY then
        -- Compensação dinâmica da metade inferior do corpo
        -- Garante que o HEIGHT_OFFSET seja a distância entre os PÉS do personagem e o chão.
        local charHeightCompensation = 3 -- Padrão (aproximado) para R6
        if LocalPlayer.Character then
            local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hum and hrp then
                if hum.RigType == Enum.HumanoidRigType.R15 then
                    charHeightCompensation = hum.HipHeight + (hrp.Size.Y / 2)
                else
                    charHeightCompensation = 3
                end
            end
        end

        -- Soma a superfície + a distância desejada + a compensação das pernas
        local targetY = surfaceY + HEIGHT_OFFSET + charHeightCompensation

        -- Aplica deadzone para evitar microoscilações
        if not lastValidY or movedSignificantly or math.abs(targetY - lastValidY) > HEIGHT_DEADZONE then
            lastValidY = targetY
        end

        cachedDesiredY = lastValidY
        lastXZPosition = currentXZ
        lastHeightUpdate = now
    else
        -- Falha do Raycast (Buraco negro, void, etc.)
        if lastValidY and not movedSignificantly then
            cachedDesiredY = lastValidY
        else
            cachedDesiredY = lastValidY or position.Y
        end
    end

    return cachedDesiredY
end
